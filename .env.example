# Development template only. Do not copy development credentials to production.
# Public values, safe to expose to the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Leave empty until an administrative API actually needs it.
SUPABASE_SECRET_KEY=

# Operations-only. Required solely by `pnpm security:hosted`; never expose in browser code.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
