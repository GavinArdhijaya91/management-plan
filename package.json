{
  "name": "siapin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "security:audit": "pnpm audit --prod --audit-level low",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images:optimize": "node scripts/optimize-images.mjs public",
    "images:check": "node scripts/optimize-images.mjs public --check",
    "images:og": "node scripts/optimize-images.mjs Siapin.png --output public/images/siapin.webp --width 1200 --height 630 --quality 84",
    "data:check": "node scripts/check-data-boundaries.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:link": "supabase link",
    "db:status": "supabase migration list",
    "db:dry-run": "supabase db push --dry-run",
    "db:push": "supabase db push",
    "db:test": "supabase test db --local",
    "db:types": "supabase gen types typescript --linked --schema public",
    "verify": "pnpm images:check && pnpm data:check && pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8.5.19",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  }
}
